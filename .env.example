# GEMINI_API_KEY: Default Google Gemini API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-key Pool for Gemini (Auto-failover and Round Robin)
GEMINI_KEY_1=""
GEMINI_KEY_2=""
GEMINI_KEY_3=""

# Optional OpenAI API Key (For multi-provider expansion)
OPENAI_API_KEY=""

# Optional Anthropic API Key
ANTHROPIC_API_KEY=""

# ADMIN_SECRET: Password for Hermes Control Panel login
ADMIN_SECRET="hermes-admin-pass-2026"

# HERMES_API_KEY: Master key for Hermes Client Agent authentication
HERMES_API_KEY="hermes-agent-secret-token"

# APP_URL: The URL where this gateway is hosted
APP_URL="MY_APP_URL"
